{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/ardev.txt",
    "color": {
      "1": "cyan"
    }
  },
  "display": {
    "separator": "  "
  },
  "modules": [
    {
      "type": "custom",
      "format": "ArDev Terminal"
    },
    {
      "type": "custom",
      "format": "Modern Developer Environment"
    },
    "break",
    "os",
    "host",
    "cpu",
    {
      "type": "gpu",
      "key": "GPU",
      "driverSpecific": true
    },
    "memory",
    "break",
    {
      "type": "shell",
      "key": "PowerShell"
    },
    "terminal",
    {
      "type": "command",
      "key": "Git",
      "text": "git --version"
    },
    {
      "type": "command",
      "key": "Docker",
      "text": "docker --version"
    },
    {
      "type": "command",
      "key": "WSL",
      "text": "wsl --version | Select-Object -First 1"
    },
  ]
}